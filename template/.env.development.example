# Required for live n8n development commands.
N8N_ENVIRONMENT=development
N8N_BASE_URL=
N8N_API_KEY=
N8N_DEVELOPMENT_WORKFLOW_ID=
N8N_DEVELOPMENT_WORKFLOW_NAME=development_project-name

# Local secret sent by Layer 3 tests to the development webhook Header Auth credential.
N8N_DEVELOPMENT_WEBHOOK_SECRET_HEADER=X-N8N-Development-Webhook-Secret
N8N_DEVELOPMENT_WEBHOOK_SECRET=

# Optional safety switches.
N8N_ACTIVATE_DEVELOPMENT_WORKFLOW=false
N8N_REQUIRE_ACTIVE_WORKFLOW=false

# Optional local path overrides. Generated files must stay under tmp/.
N8N_LOCAL_WORKFLOW_PATH=workflow.json
N8N_DEVELOPMENT_VARIANT_PATH=tmp/n8n-development-workflow.generated.json
N8N_REMOTE_SNAPSHOT_PATH=tmp/n8n-development-workflow.remote.json
